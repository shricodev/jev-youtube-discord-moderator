# Discord
DISCORD_TOKEN=
WATCH_CHANNEL_ID=            # optional: only moderate this channel
FLOOD_WEBHOOK_URL=           # webhook in the test channel

# Composio
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=            # the user ID your Jev connection is attached to

# Optional tuning
JEV_MODEL=                   # blank = jev-latest
JEV_TOOLKIT_VERSION=         # blank = latest with dangerouslySkipVersionCheck
DELETE_THRESHOLD=0.8         # noul >= this → delete
REVIEW_THRESHOLD=0.5         # between review and delete → log as REVIEW, keep message
MAX_IN_FLIGHT=16             # max concurrent Jev calls
FLOOD_TOXIC_RATIO=0.5        # share of hostile messages in the flood
