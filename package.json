{
  "name": "jev-live-chat-moderator",
  "version": "1.0.0",
  "description": "Real-time Discord and Twitch chat moderation with TypeSafe Jev, via Composio or OpenRouter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preflight": "node --env-file=.env preflight.mjs",
    "bot": "node --env-file=.env jev-mod.mjs bot",
    "flood": "node --env-file=.env jev-mod.mjs flood",
    "twitch:auth": "node --env-file=.env twitch-mod.mjs auth",
    "twitch:bot": "node --env-file=.env twitch-mod.mjs bot",
    "twitch:flood": "node --env-file=.env twitch-mod.mjs flood",
    "check": "for f in *.mjs lib/*.mjs; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@composio/core": "0.20.0",
    "discord.js": "^14"
  }
}
