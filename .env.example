# Copy to .env and fill in. Blank optional values fall back to the defaults shown.

# ── Jev provider: "composio" (default) or "openrouter"
JEV_PROVIDER=composio

# Composio (JEV_PROVIDER=composio)
# API key from https://dashboard.composio.dev
COMPOSIO_API_KEY=
# The user ID your Jev connected account belongs to
COMPOSIO_USER_ID=
# Optional: pin the Jev toolkit version (recommended in production). Blank = latest.
JEV_TOOLKIT_VERSION=

# OpenRouter (JEV_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# ── Discord (npm run bot / npm run flood)
DISCORD_TOKEN=
# Optional: only moderate this channel. Blank = every channel the bot can see.
WATCH_CHANNEL_ID=
# Webhook in the test channel, used by the flooder only
FLOOD_WEBHOOK_URL=

# ── Twitch (npm run twitch:*)
# Client ID of a "Public" app from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
# Optional: channel login to moderate (the bot account must be a mod there). Blank = the bot account's own channel.
TWITCH_CHANNEL=

# ── Optional tuning
# Jev model. Blank = provider default (OpenRouter: ~typesafe/jev-latest)
JEV_MODEL=
# Abort a Jev call after this many ms (default 10000)
JEV_TIMEOUT_MS=
# noul >= this → delete the message (default 0.8)
DELETE_THRESHOLD=
# noul >= this but below DELETE_THRESHOLD → log as REVIEW, keep the message (default 0.5)
REVIEW_THRESHOLD=
# Max concurrent Jev calls (default 16)
MAX_IN_FLIGHT=
# Share of hostile messages in the flood, 0..1 (default 0.5)
FLOOD_TOXIC_RATIO=
# Gap between Twitch flood messages in ms; non-mods get ~20 msgs / 30 s (default 1600)
FLOOD_INTERVAL_MS=
